{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./backend.json",
  "compilerOptions": {
    "types": ["node", "vitest"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["../../apps/backend/src/**/*", "../../apps/backend/test/**/*"],
  "exclude": ["../../apps/backend/node_modules", "../../apps/backend/dist", "../../apps/backend/coverage"]
}
